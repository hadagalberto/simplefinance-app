# SimpleFinance environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.

# --- Postgres ---
POSTGRES_DB=simplefinance
POSTGRES_USER=simplefinance
# Use a strong, unique password in real deployments.
POSTGRES_PASSWORD=changeme

# --- API: database connection ---
# Must match the POSTGRES_* values above. Host is the Compose service name ("postgres"), not
# localhost, since the API talks to Postgres over the Compose network.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=simplefinance;Username=simplefinance;Password=changeme

# --- API: JWT auth (consumed starting 01-04) ---
# Generate with: openssl rand -base64 64
Jwt__SigningKey=<generate with e.g. openssl rand -base64 64>
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# --- API: CORS (consumed starting 01-04) ---
# Origin the frontend is served from. Must match exactly (scheme+host+port) — the API needs
# AllowCredentials for the httpOnly refresh cookie, which disallows a wildcard origin.
Cors__AllowedOrigin=http://localhost:5173

# --- API: TOTP 2FA secret encryption (consumed starting 01-05) ---
# Generate with: openssl rand -base64 32
# Must be a DISTINCT value from Jwt__SigningKey (PITFALLS.md #12 — never reuse secrets across
# purposes; a leak of one key must not compromise the other).
Totp__EncryptionKey=<generate with e.g. openssl rand -base64 32, distinct from Jwt signing key>

# --- Tests: Postgres advisory-lock integration test (consumed starting 02-04) ---
# ConcurrentSyncTests needs a real Postgres connection (advisory locks aren't supported by EF
# InMemory). Points at the docker-compose postgres service's loopback-only port mapping
# (127.0.0.1:5433 -> container 5432). Falls back to this same value in-code if unset.
ConnectionStrings__Test=Host=localhost;Port=5433;Database=simplefinance;Username=simplefinance;Password=changeme

# --- API: Pluggy client (consumed starting 02-02) ---
# Pluggy Dashboard -> Application -> Client ID / Client Secret. Extremely sensitive — server-side
# only, never exposed to the browser.
Pluggy__ClientId=<from Pluggy Dashboard>
Pluggy__ClientSecret=<from Pluggy Dashboard>
# "sandbox" (default) or "production" — no dashboard lookup needed.
Pluggy__Environment=sandbox
# Public HTTPS URL Pluggy delivers webhook events to (e.g. https://yourdomain/api/webhooks/pluggy).
# No public URL exists in local dev — leave unset until deploy (02-CONTEXT.md).
Pluggy__WebhookPublicUrl=
# Generate with: openssl rand -base64 32. Echoed back by Pluggy on every webhook call and
# validated server-side (constant-time compare) — no HMAC signature scheme exists to verify
# against instead (02-RESEARCH.md).
Pluggy__WebhookSecretValue=<generate with e.g. openssl rand -base64 32>

# --- API: AI providers (consumed starting 15-05) ---
# DeepSeek (chat/completions) and OpenAI (embeddings) bearer keys. Server-side only — never stored
# in the DB, never returned by the API (the settings endpoint reports only key-present status).
# The app runs fully without these: missing keys degrade like an over-budget/outage (no cloud AI).
# Only these two keys are required env vars (the AI job crons Ai__*CronExpression are optional env
# overrides with sane in-code defaults; see README.md). The AI budget cap
# (AiMonthlyBudgetUsd, default 3.00 USD, 0 = zero cloud calls), auto-apply threshold
# (AiAutoApplyThreshold 0.85), per-feature model names (deepseek-chat/deepseek-reasoner) and the
# master/per-feature enable flags all live in UserSettings (DB) and are edited via Settings -> IA,
# NOT here. See README.md "AI layer (v3.0)".
Ai__DeepSeekApiKey=<from DeepSeek platform>
Ai__OpenAiApiKey=<from OpenAI platform>
# Optional chat providers, picked per call from the model name typed in Settings -> IA:
# claude-* -> Anthropic, vendor/model slug (e.g. openai/gpt-5) -> OpenRouter, anything else ->
# DeepSeek. Same handling as above (server-side only, overridable from Settings -> IA, never
# returned). Leave empty if you only use DeepSeek.
Ai__AnthropicApiKey=
Ai__OpenRouterApiKey=

# --- API: sync jobs / manual sync (consumed starting 02-06) ---
# Cron expression (Hangfire/NCrontab syntax) for DailySyncJob's 2x/day cron backstop. Server-local
# time -- see the code comment in Program.cs for the PITFALLS.md #8 timezone caveat. Default
# matches PRD §6.3/RF-SYNC-002's 06:00/18:00 example.
Sync__DailySyncCronExpression=0 6,18 * * *
# Cooldown window (seconds) the manual-sync endpoints enforce per connection before enqueuing
# another sync -- protects the Open Finance monthly quota from rapid repeat "Atualizar agora"
# clicks (02-RESEARCH.md).
Sync__ManualSyncCooldownSeconds=60

# --- API: notification channels (consumed starting 08-02, NOTIF-01) ---
# ALL of the following are OPTIONAL — the app runs correctly with zero channels configured
# (common first-run state); NotificationDispatcher silently skips any unconfigured channel
# instead of crashing.
#
# Telegram (primary channel): bot token from @BotFather (message @BotFather -> /newbot), plus the
# numeric chat id to send alerts to (message your new bot once, then GET
# https://api.telegram.org/bot<token>/getUpdates to read back the chat id). Leave both unset to
# disable Telegram entirely.
Notifications__TelegramBotToken=
Notifications__TelegramChatId=
# SMTP (secondary/optional channel): host/port/user/password/from. Leave SmtpHost and
# SmtpFromAddress unset to disable email entirely — SmtpUser/SmtpPassword may also be left blank
# for an anonymous-relay SMTP server (EmailChannel skips AuthenticateAsync when either is empty).
Notifications__SmtpHost=
Notifications__SmtpPort=587
Notifications__SmtpUser=
Notifications__SmtpPassword=
Notifications__SmtpFromAddress=
Notifications__SmtpFromName=SimpleFinance
Notifications__SmtpUseSsl=true

# --- API: runtime environment ---
ASPNETCORE_ENVIRONMENT=Production

# --- Frontend build ---
# Base URL the frontend uses to reach the API. In local dev with `docker compose up`, the API
# is published on host port 5080 (see docker-compose.yml).
VITE_API_BASE_URL=http://localhost:5080
