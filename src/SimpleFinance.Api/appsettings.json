{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:5173"
  },
  "Sync": {
    "DailySyncCronExpression": "0 6,18 * * *",
    "ManualSyncCooldownSeconds": 60
  },
  "NetWorth": {
    "SnapshotCronExpression": "30 0 * * *"
  },
  "Recurring": {
    "LookbackMonths": 18,
    "MinOccurrences": 3,
    "AmountTolerancePercent": 0.10,
    "WeeklyToleranceDays": 2,
    "MonthlyMinDays": 25,
    "MonthlyMaxDays": 35,
    "YearlyToleranceDays": 15,
    "AmountIncreaseThresholdPercent": 0.15,
    "DetectionCronExpression": "0 3 * * 1"
  },
  "Alerts": {
    "LargeTransactionLookbackDays": 3
  },
  "Notifications": {
    "TelegramBotToken": "",
    "TelegramChatId": "",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "SmtpFromAddress": "",
    "SmtpFromName": "SimpleFinance",
    "SmtpUseSsl": true
  },
  "Ai": {
    "DeepSeekApiKey": "",
    "OpenAiApiKey": "",
    "AnthropicApiKey": "",
    "OpenRouterApiKey": "",
    "DeepSeek": { "BaseUrl": "https://api.deepseek.com" },
    "OpenAi": { "BaseUrl": "https://api.openai.com/v1/" },
    "Anthropic": { "BaseUrl": "https://api.anthropic.com" },
    "OpenRouter": { "BaseUrl": "https://openrouter.ai/api/v1/" },
    "Pricing": {
      "deepseek-chat": { "InputPerMillion": 0.14, "CachedInputPerMillion": 0.0028, "OutputPerMillion": 0.28 },
      "deepseek-reasoner": { "InputPerMillion": 0.14, "CachedInputPerMillion": 0.0028, "OutputPerMillion": 0.28 },
      "deepseek-v4-flash": { "InputPerMillion": 0.14, "CachedInputPerMillion": 0.0028, "OutputPerMillion": 0.28 },
      "claude-opus-5-5": { "InputPerMillion": 4, "CachedInputPerMillion": 0.20, "OutputPerMillion": 20 },
      "claude-sonnet-5-5": { "InputPerMillion": 2, "CachedInputPerMillion": 0.10, "OutputPerMillion": 10 },
      "claude-haiku-5-5": { "InputPerMillion": 0.10, "CachedInputPerMillion": 0.01, "OutputPerMillion": 0.50 },
      "text-embedding-3-small": { "InputPerMillion": 0.02 }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
